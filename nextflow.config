
// ---------------------------------------------------------------------------------- //
//                             Nextflow / executor settings
// ---------------------------------------------------------------------------------- //
conda.enabled = true

profiles {
    local { includeConfig 'conf/local.config'}
    lsf { includeConfig 'conf/lsf.config'}
    lsf_ignore_errors { includeConfig 'conf/lsf_ignore_errors.config'}
}

report.overwrite=true
trace.overwrite=true

// Set work dir
workDir="../workdir"

manifest {
    name            = 'edit-quant'
    description     = 'Amplicon mapping (BWA) + CRISPRessoPooled editing-efficiency pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
}

// ---------------------------------------------------------------------------------- //
//                                    Process labels
// ---------------------------------------------------------------------------------- //
includeConfig 'conf/processes.config'

// ---------------------------------------------------------------------------------- //
//                                  Plugins & Schema
// ---------------------------------------------------------------------------------- //
plugins {
  id 'nf-schema@2.7.3'
}

validation {
  help {
    enabled = true
  }
  
  logging {
    // Throw an error if a unrecognized parameter exists, comment this option
    // to just run throw a warning
    unrecognisedParams = "error"
  }
}

// ---------------------------------------------------------------------------------- //
//                                      Parameters
// ---------------------------------------------------------------------------------- //
params {
    // --- required inputs ---
    amplicon_manifest     = null  // TSV: gene/guide/primer design manifest (see README for columns)
    fastq_manifest        = null  // TSV: sample, fastq_1, fastq_2 (header row required)

    ref_fasta             = null  // reference genome FASTA (required)
    genes_gtf             = null  // optional: builds gene_bed/exon_bed from this GTF if gene_bed isn't supplied
    bwa_index_prefix      = null  // optional: defaults to ref_fasta; built with bwa index if missing

    ref_fai               = null  // optional: defaults to "${ref_fasta}.fai"; built with samtools faidx if missing
    gene_bed              = null  // optional if genes_gtf is given
    exon_bed              = null  // optional; adds overlapping_exons column to validation_report.tsv

    outdir                = '../results'

    // --- amplicon mapping tuning (see mapping_amplicons/README.md for full rationale) ---
    bwa_n                 = 2      // max edit distance for the off-target (mismatch-tolerant) BWA pass
    max_xa                = 1000   // max alternative hits BWA reports per query in that pass
    max_mismatch          = 2      // edit-distance threshold for a hit to count as a high-quality off-target
    gene_window           = 500    // bp padding around each gene when checking guide/primer overlap
    high_copy_threshold   = 50     // flag guide/primer as HIGH_COPY_NUMBER above this many tied-best hits
    reassign_primary      = true   // promote gene-matching tied alternates to primary; log + corrected BAM

    // --- CRISPRessoPooled ---
    crispresso_n_processes = 1
}

